# ШАГ 5. Переименуйте файл в tests.yml (уберите .example) и заполните места с TODO.
name: tests

on: [push, pull_request]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      # TODO: установите зависимости из requirements.txt (python -m pip install -r ...)
      # TODO: запустите pytest с покрытием по веткам: --cov=app --cov-branch и сохранением --alluredir=allure-results
      # TODO: загрузите артефакты htmlcov и allure-results (actions/upload-artifact@v4)
      #       и сделайте так, чтобы шаг выполнялся даже при падении тестов:  if: always()
